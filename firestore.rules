rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for Admin check
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Owner can update their data, but cannot modify their 'role'
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // User quests subcollection
      match /quests/{questId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Products collection
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Sales collection and subcollection items
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }

    // Counters collection (required for sales transactions)
    match /counters/{counterId} {
      allow read, update, create: if isAuthenticated();
      allow delete: if false;
    }

    // Achievements collection (catalog read-only for clients)
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Config collection (e.g., config/admins)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
